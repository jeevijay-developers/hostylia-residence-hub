# Hostylia web (hostylia-residence-hub) — names only. Copy to .env (gitignored).
# Never put real secrets in this file. Never prefix MSG91_AUTH_KEY or Razorpay
# key secret / webhook secret with VITE_.

# --- Client (Vite inlines VITE_*) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server (TanStack Start server functions; not inlined) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local Parent OTP bypass (NODE_ENV=development only)
DEV_TEST_LOGIN_ENABLED=
DEV_TEST_PARENT_PHONE=
DEV_TEST_PARENT_OTP=
DEV_TEST_PARENT_PASSWORD=
DEV_TEST_PHONES=

# MSG91 (Edge Functions + Auth Send SMS hook). Never VITE_.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_AUTH_LOGIN_OTP=
MSG91_TEMPLATE_SUB_EXPIRY=
MSG91_TEMPLATE_GATE_PASS_APPROVED=
MSG91_TEMPLATE_PAY_OVERDUE=
MSG91_TEMPLATE_LATE_ENTRY=
MSG91_TEMPLATE_ADMISSION_APPROVED=
MSG91_TEMPLATE_STAFF_ACCESS_REVOKED=
MSG91_TEMPLATE_NOTICE_BROADCAST=
MSG91_TEMPLATE_GATE_EVENT=
MSG91_TEMPLATE_VISITOR_GATE=
MSG91_TEMPLATE_PAYMENT_RECEIPT=
MSG91_TEMPLATE_STAFF_INVITE=
MSG91_TEMPLATE_SUPPORT_SESSION_STARTED=
MSG91_TEMPLATE_SUPPORT_SESSION_ENDED=
MSG91_OTP_VAR=
MSG91_OTP_MINUTES=
SEND_SMS_HOOK_SECRET=

# Razorpay TEST keys on Edge. Key ID may also be returned by razorpay-create-order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email / optional SMS fallback
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

APP_URL=
